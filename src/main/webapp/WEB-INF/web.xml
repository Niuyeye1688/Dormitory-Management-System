<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>学生宿舍管理系统</display-name>

    <!-- 欢迎页面 -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- 编码过滤器 -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.dormitory.filter.EncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- CSRF 防护过滤器 -->
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.dormitory.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/student/*</url-pattern>
        <url-pattern>/changePassword</url-pattern>
    </filter-mapping>

    <!-- 登录权限过滤器 -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.dormitory.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/student/*</url-pattern>
    </filter-mapping>

    <!-- 验证码 Servlet -->
    <servlet>
        <servlet-name>VerifyCodeServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.common.VerifyCodeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VerifyCodeServlet</servlet-name>
        <url-pattern>/verifyCode</url-pattern>
    </servlet-mapping>

    <!-- 公共 Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.common.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.common.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ChangePasswordServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.common.ChangePasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChangePasswordServlet</servlet-name>
        <url-pattern>/changePassword</url-pattern>
    </servlet-mapping>

    <!-- 管理员端 Servlet -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.admin.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentManageServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.admin.StudentManageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentManageServlet</servlet-name>
        <url-pattern>/admin/student</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.admin.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <!-- 学生端 Servlet -->
    <servlet>
        <servlet-name>StudentDashboardServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.student.StudentDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentDashboardServlet</servlet-name>
        <url-pattern>/student/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.student.StudentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentServlet</servlet-name>
        <url-pattern>/student/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MyDormitoryServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.student.MyDormitoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyDormitoryServlet</servlet-name>
        <url-pattern>/student/myDormitory</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RepairServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.student.RepairServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RepairServlet</servlet-name>
        <url-pattern>/student/repair</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AnnouncementViewServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.student.AnnouncementViewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AnnouncementViewServlet</servlet-name>
        <url-pattern>/student/announcement</url-pattern>
    </servlet-mapping>

    <!-- 管理员端 Servlet (补充) -->
    <servlet>
        <servlet-name>BuildingServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.admin.BuildingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BuildingServlet</servlet-name>
        <url-pattern>/admin/building</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DormitoryServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.admin.DormitoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DormitoryServlet</servlet-name>
        <url-pattern>/admin/dormitory</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AllocationServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.admin.AllocationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AllocationServlet</servlet-name>
        <url-pattern>/admin/allocation</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RepairManageServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.admin.RepairManageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RepairManageServlet</servlet-name>
        <url-pattern>/admin/repair</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AnnouncementServlet</servlet-name>
        <servlet-class>com.dormitory.servlet.admin.AnnouncementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AnnouncementServlet</servlet-name>
        <url-pattern>/admin/announcement</url-pattern>
    </servlet-mapping>

    <!-- 会话超时 30 分钟 -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- JSP 编码配置 -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
        </jsp-property-group>
    </jsp-config>

    <!-- 错误页面 -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/common/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/common/error.jsp</location>
    </error-page>

</web-app>
